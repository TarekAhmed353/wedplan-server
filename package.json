{
  "name": "wedplan-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for WedPlan, a wedding planning platform",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "start": "node index.js",
    "make-admin": "node --env-file-if-exists=.env scripts/make-admin.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "mongodb": "^7.9.1",
    "stripe": "^23.2.0"
  }
}
